{UTF-8}
Volumen 1= INTEG (
	q in-q12-q d,
		0.5)
	~	m*m*m
	~	Volumen de pocion en el alambique 1 (nivel). Inicial 0,5 m3 = 0,5 m de \
		altura.
	|

h1=
	Volumen 1/A
	~	m
	~	Altura del liquido en el alambique 1.
	|

q in=
	0.4*v1
	~	m*m*m/Second
	~	Caudal de entrada (flujo). q_in = 0,4*v1.
	|

q12=
	c1*SQRT(MAX(h1, 0))
	~	m*m*m/Second
	~	Caudal de salida por el orificio (flujo, Torricelli).
	|

q d=
	0
	~	m*m*m/Second
	~	Consumo del caldero (perturbacion). 0 en el nivel 1.
	|

v1=
	STEP(1, 2)
	~	Dmnl
	~	Apertura de la valvula de entrada (0 a 1). Escalon de 0 a 1 a los 2 s.
	|

A=
	1
	~	m*m
	~	Area transversal del alambique.
	|

c1=
	0.2
	~	m*m*m/Second
	~	Coeficiente de descarga, 0,2 m^2,5/s (Vensim no maneja la unidad m^2,5).
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 20
	~	Second
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Second
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Second [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.01
	~	Second [0,?]
	~	The time step for the simulation.
	|

