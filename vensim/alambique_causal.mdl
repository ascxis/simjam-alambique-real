{UTF-8}
h1  = A FUNCTION OF( q in,-q12,-q d)
	~	m
	~	Nivel del alambique 1.
	|

q12  = A FUNCTION OF( h1)
	~	m*m*m/Second
	~	Caudal de salida por el orificio.
	|

q in  = A FUNCTION OF( v1)
	~	m*m*m/Second
	~	Caudal de entrada.
	|

v1  = A FUNCTION OF( Jugador)
	~	Dmnl
	~	Apertura de la valvula de entrada (mano derecha).
	|

Jugador  = A FUNCTION OF( error)
	~
	~	El jugador mira la HMI (sensor), decide (controlador) y mueve la mano.
	|

error  = A FUNCTION OF( h sp,-h1)
	~	m
	~	e = h_sp - h1.
	|

h sp  = A FUNCTION OF( )
	~	m
	~	Setpoint del nivel.
	|

q d  = A FUNCTION OF( )
	~	m*m*m/Second
	~	Consumo del caldero (perturbacion).
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 20
	~	Second
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Second
	~	The initial time for the simulation.
	|

SAVEPER  =
        TIME STEP
	~	Second [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.01
	~	Second [0,?]
	~	The time step for the simulation.
	|

