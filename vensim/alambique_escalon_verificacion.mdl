{UTF-8}
Volumen 1= INTEG (
	q in-q12-q d,
		1.5)
	~	m*m*m
	~	Volumen de pocion en el alambique 1 (nivel). Inicial 1,5 m3 = 1,5 m de altura (punto de operacion del nivel 1).
	|

h1=
	Volumen 1/A
	~	m
	~	Altura del liquido en el alambique 1.
	|

q in=
	0.4*v1
	~	m*m*m/Second
	~	Caudal de entrada (flujo). q_in = 0,4*v1.
	|

q12=
	c1*SQRT(MAX(h1, 0))
	~	m*m*m/Second
	~	Caudal de salida por el orificio (flujo, Torricelli).
	|

q d=
	0
	~	m*m*m/Second
	~	Consumo del caldero (perturbacion). 0 en el nivel 1.
	|

v1=
	IF THEN ELSE(Time<2, 0.612372, MIN(0.622372, 0.612372+0.25*(Time-2)))
	~	Dmnl
	~	Escalon de verificacion (5.9): v1 en el equilibrio de 1,5 m (0,612372) y a los 2 s sube 0,01 con la rampa de la valvula del juego (0,25 1/s), igual que ?control=escalon.
	|

A=
	1
	~	m*m
	~	Area transversal del alambique.
	|

c1=
	0.2
	~	m*m*m/Second
	~	Coeficiente de descarga, 0,2 m^2,5/s (Vensim no maneja la unidad m^2,5).
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 80
	~	Second
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Second
	~	The initial time for the simulation.
	|

SAVEPER  =
        TIME STEP
	~	Second [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 0.01
	~	Second [0,?]
	~	The time step for the simulation.
	|

